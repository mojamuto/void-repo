# Template file for 'noctalia'
pkgname=noctalia
version=5.2.0
revision=1
build_style=meson
configure_args="-Dtests=disabled -Dnative_optimizations=false"
hostmakedepends="pkg-config wayland-devel"
makedepends="wayland-devel wayland-protocols libepoxy-devel MesaLib-devel
 libglvnd-devel glib-devel cairo-devel pango-devel fontconfig-devel
 freetype-devel harfbuzz-devel libxkbcommon-devel pipewire-devel
 wireplumber-devel libsecret-devel libsodium-devel libcurl-devel pam-devel
 libwebp-devel libjxl-devel libsndfile-devel basu-devel sdbus-c++-devel
 libmd4c-devel tomlplusplus-devel libical-devel json-c++ stb polkit-devel
 librsvg-devel libqalculate-devel libxml2-devel"
depends="dbus pipewire wireplumber git sound-theme-freedesktop"
short_desc="Sleek, customizable desktop shell crafted for Wayland"
license="MIT, Apache-2.0"
homepage="https://github.com/noctalia-dev/noctalia"
changelog="https://github.com/noctalia-dev/noctalia/releases"
distfiles="https://github.com/noctalia-dev/noctalia/archive/refs/tags/v${version}.tar.gz"
checksum=b1080bcb19c9ee7836153464d99021f34d1e3564f4bf4a26331a2af21234ddf8

# jemalloc solo se usa en glibc
if [ "$XBPS_TARGET_LIBC" = "glibc" ]; then
	makedepends+=" jemalloc-devel"
	configure_args+=" -Djemalloc=enabled"
else
	configure_args+=" -Djemalloc=disabled"
fi

post_install() {
	vlicense LICENSE
	vlicense third_party/luau/LICENSE.txt LICENSE.luau
	vlicense third_party/luau/lua_LICENSE.txt LICENSE.lua
	vlicense third_party/fzy/LICENSE LICENSE.fzy
	vlicense third_party/material_color_utilities/LICENSE LICENSE.mcu
	vlicense third_party/wuffs/LICENSE-APACHE LICENSE.wuffs-apache
	vlicense third_party/wuffs/LICENSE-MIT LICENSE.wuffs-mit

	if [ -z "$CROSS_BUILD" ]; then
		build/noctalia completions bash > noctalia.bash
		build/noctalia completions zsh > noctalia.zsh
		build/noctalia completions fish > noctalia.fish
		vcompletion noctalia.bash bash noctalia
		vcompletion noctalia.zsh zsh noctalia
		vcompletion noctalia.fish fish noctalia
	fi
}
