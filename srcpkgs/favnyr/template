# Template file for 'favnyr'
pkgname=favnyr
version=0.3.4
revision=1
build_style=cargo
make_build_args="-p favnyr-gui"
make_install_args="--path crates/favnyr-gui"
hostmakedepends="pkg-config"
makedepends="fontconfig-devel"
depends="fontconfig libxkbcommon wayland libX11 libXcursor libXrandr libXi libxcb libGL libEGL vulkan-loader xdg-utils ffmpeg poppler-utils"
short_desc="Modern and lightweight file manager written in Rust with Slint"
license="GPL-3.0-or-later"
homepage="https://github.com/GlitchAwakened/Favnyr"
distfiles="https://github.com/GlitchAwakened/Favnyr/archive/refs/tags/v${version}.tar.gz"
checksum=fd61b7194163d337b4b43dd1a96ca1c732e7a8b3cdc0e636275ce2d1c5c98c8f

post_install() {
	vinstall crates/favnyr-gui/assets/favnyr.svg 644 \
		usr/share/icons/hicolor/scalable/apps
	vmkdir usr/share/applications
	printf '%s\n' \
		'[Desktop Entry]' \
		'Type=Application' \
		'Name=Favnyr' \
		'GenericName=File Manager' \
		'Comment=A modern and lightweight file manager' \
		'Exec=favnyr' \
		'Icon=favnyr' \
		'Terminal=false' \
		'Categories=System;FileManager;Utility;' \
		> ${DESTDIR}/usr/share/applications/favnyr.desktop
}
